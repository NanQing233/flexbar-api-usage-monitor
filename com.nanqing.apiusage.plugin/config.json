{
  "intervalSeconds": 30,
  "asciiOnlyTitles": true,
  "providers": {
    "deepseek": {
      "enabled": true,
      "name": "DeepSeek",
      "apiKey": "",
      "endpoint": "https://api.deepseek.com/user/balance",
      "authType": "bearer",
      "headerName": "",
      "headerPrefix": "",
      "query": "",
      "valuePath": "balance_infos",
      "valueField": "total_balance",
      "currency": "CNY",
      "sumField": "",
      "scale": 1,
      "unit": "CNY"
    },
    "kimi": {
      "enabled": true,
      "name": "Kimi",
      "apiKey": "",
      "endpoint": "https://api.moonshot.ai/v1/users/me/balance",
      "authType": "bearer",
      "headerName": "",
      "headerPrefix": "",
      "query": "",
      "valuePath": "data.available_balance",
      "valueField": "",
      "currency": "",
      "sumField": "",
      "scale": 1,
      "unit": "USD"
    },
    "chatgpt": {
      "enabled": true,
      "name": "ChatGPT",
      "apiKey": "",
      "endpoint": "https://api.openai.com/v1/organization/costs",
      "authType": "bearer",
      "headerName": "",
      "headerPrefix": "",
      "query": "start_time={monthStart}&end_time={now}&bucket_width=1d&limit=180",
      "valuePath": "",
      "valueField": "",
      "currency": "",
      "sumField": "amount.value",
      "scale": 1,
      "unit": "USD"
    },
    "claude": {
      "enabled": true,
      "name": "Claude",
      "apiKey": "",
      "endpoint": "https://api.anthropic.com/v1/organizations/cost_report",
      "authType": "x-api-key",
      "headerName": "",
      "headerPrefix": "",
      "query": "starting_at={monthStartISO}&ending_at={nowISO}&bucket_width=1d&limit=31",
      "valuePath": "",
      "valueField": "",
      "currency": "",
      "sumField": "amount",
      "scale": 0.01,
      "unit": "USD"
    },
    "custom": {
      "enabled": true,
      "name": "Custom",
      "apiKey": "",
      "endpoint": "",
      "authType": "bearer",
      "headerName": "Authorization",
      "headerPrefix": "Bearer ",
      "query": "",
      "valuePath": "",
      "valueField": "",
      "currency": "",
      "sumField": "",
      "scale": 1,
      "unit": ""
    }
  }
}
